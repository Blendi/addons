{
    "name": "iPerf3",
    "version": "3.22.3",
    "slug": "iperf3",
    "description": "iPerf3 add-on for Home Assistant",
    "arch": ["amd64", "aarch64"],
    "image": "ghcr.io/blendi/iperf3-{arch}",
    "boot": "manual",
    "init": false,
    "ports": {
        "5201/tcp": 5201,
        "5201/udp": 5201
    },
    "ports_description": {
        "5201/tcp": "TCP",
        "5201/udp": "UDP"
    },
    "homeassistant": "0.108.0",
    "options": {
        "arguments": "-s"
    },
    "schema": {
        "arguments": "str"
    }
}
